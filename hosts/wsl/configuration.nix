{
  pkgs,
  inputs,
  username,
  ...
}:
{
  imports = [
    inputs.wsl.nixosModules.wsl

    ../../modules/programming

    ../../modules/commandLine.nix
    ../../modules/containers.nix
    ../../modules/git.nix
    ../../modules/headless.nix

    ../configuration.nix
