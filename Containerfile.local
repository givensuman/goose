# A thin layer on top of the published image, for quick local iteration.
# Built and switched to by `just switch`; see Justfile.
ARG BASE="ghcr.io/givensuman/goose:latest"

FROM ${BASE}

COPY local_files /

RUN --mount=type=bind,source=local/build.sh,target=/ctx/build.sh \
    --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=tmpfs,dst=/tmp \
    /bin/bash -c "\
    echo 'Building'...\
    "

RUN bootc container lint
